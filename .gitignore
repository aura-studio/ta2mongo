# Compiled binary (root `go build .` produces ./tango)
/tango
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries and coverage output
*.test
*.out
coverage.*

# The DocumentDB CA bundle lives at assets/global-bundle.pem (tracked); ignore
# any stray copy re-downloaded to the repo root, plus a stray soak binary from
# running `go build ./test/soak` at the root.
/global-bundle.pem
/soak
profile.cov

# Go workspace files (local-only)
go.work
go.work.sum

# Local agent/tool state
/.sixth/skills/
/.orchestrator/

# Vendored deps are not committed (module mode)
/vendor/

# Local runtime config dropped next to the binary at repo root.
# Shipped samples live under examples/config/ and are NOT ignored.
/standalone.yaml
/standalone.yml
/standalone.json
/agent.yaml
/agent.yml
/agent.json
/client.yaml
/client.yml
/client.json
/tango.yaml
/tango.yml
/tango.json

# Editor / IDE
.idea/
.vscode/
*.swp
*~

# OS noise
.DS_Store
Thumbs.db
