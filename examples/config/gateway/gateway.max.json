{
  "logging": { "level": "info", "format": "text" },
  "dao": {
    "mongo": {
      "uri": "mongodb://localhost:27017/tango",
      "connectTimeout": "10s",
      "serverSelectionTimeout": "30s"
    },
    "store": { "maxElapsedTime": "10s" }
  },
  "parser": {
    "filter": { "include": [], "exclude": [] }
  },
  "process": {
    "batchSize": 1000,
    "pipeline": {
      "batchSize": 1000,
      "batchWorkers": 2,
      "flushInterval": "1s",
      "deadLetterCap": 128
    }
  },
  "role": {
    "gateway": {
      "addr": ":8080",
      "defaultMode": "batch"
    }
  }
}
