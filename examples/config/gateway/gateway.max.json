{
  "logging": { "level": "info", "format": "text" },
  "dao": {
    "mongo": {
      "uri": "mongodb://localhost:27017/tango",
      "connectTimeout": "10s",
      "serverSelectionTimeout": "30s"
    },
    "store": { "maxElapsedTime": "10s" }
  },
  "role": {
    "gateway": {
      "addr": ":8080",
      "upload": {
        "defaultMode": "batch",
        "batchSize": 1000,
        "filter": { "include": [], "exclude": [] },
        "pipeline": {
          "batchSize": 1000,
          "batchWorkers": 2,
          "flushInterval": "1s",
          "deadLetterCap": 128
        }
      }
    }
  }
}
