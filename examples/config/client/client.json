{
  "logging": { "level": "info" },
  "mongo": { "uri": "mongodb://localhost:27017/tango", "maxElapsedTime": "10s" },
  "stringUpload": { "batchSize": 1000, "filter": { "include": [], "exclude": [] } },
  "fileUpload": {
    "logPattern": ["/var/log/ta/.*\\.log"],
    "maxLineBytes": 10485760,
    "checkpointCollection": "_tango_fileupload",
    "pipeline": { "batchSize": 1000 }
  },
  "backfill": {
    "apiBaseURL": "https://ta-receiver.example.com",
    "token": "YOUR_TA_TOKEN",
    "projectID": 102,
    "partDateRange": { "start": "2026-05-01", "end": "2026-05-07" },
    "runID": "backfill-2026-05",
    "pageSize": 10000
  },
  "backfillFilter": {
    "table": "event",
    "events": ["PaymentOrderState", "login"],
    "include": [],
    "exclude": []
  },
  "sql": { "schemaPrefix": "" },
  "publish": {
    "tasksCollection": "_tango_tasks",
    "instancesCollection": "_tango_instances",
    "instanceTTL": "90s"
  },
  "server": { "addr": ":8080" }
}
